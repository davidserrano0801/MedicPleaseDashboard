MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=cambia-esta-clave
MONGO_APP_USER=plataforma_app
MONGO_APP_PASSWORD=cambia-esta-clave-tambien
MONGO_DATABASE=plataforma

DJANGO_SECRET_KEY=genera-una-clave-larga-y-aleatoria
DJANGO_DEBUG=0
# Agrega aquí la IP o dominio con el que Unity llegará al servidor
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Clave que Unity enviará en la cabecera X-API-Key (openssl rand -hex 24)
GAME_API_KEY=genera-otra-clave-aleatoria
