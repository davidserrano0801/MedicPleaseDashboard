MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=cambia-esta-clave
MONGO_APP_USER=plataforma_app
MONGO_APP_PASSWORD=cambia-esta-clave-tambien
MONGO_DATABASE=plataforma

DJANGO_SECRET_KEY=genera-una-clave-larga-y-aleatoria
DJANGO_DEBUG=0
# Ya no hace falta agregar la IP del servidor: Nginx habla con Django como "localhost".
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Clave que Unity enviará en la cabecera X-API-Key (openssl rand -hex 24)
GAME_API_KEY=genera-otra-clave-aleatoria

# Primer administrador (se crea solo la primera vez que alguien inicia sesión y
# no existe ningún administrador). Contraseña de mínimo 8 caracteres.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-clave-de-administrador
# Ponlo en 1 cuando sirvas el sitio por HTTPS
AUTH_COOKIE_SECURE=0

# Puerto en el que se publica la web en este equipo (si el 80 está ocupado, usa 8080).
# Entonces la URL será http://IP-DEL-SERVIDOR:8080
HTTP_PORT=80

# ---- Dirección pública con Tailscale Funnel (opcional) ----
# Descomenta COMPOSE_PROFILES para que "docker compose up" también arranque el túnel.
#COMPOSE_PROFILES=funnel
# Clave de autenticación de Tailscale (Settings > Keys > Generate auth key, sin etiquetas).
# Solo se usa la primera vez; si la dejas vacía, el enlace de inicio de sesión sale en
# "docker compose logs tailscale".
TS_AUTHKEY=
# La dirección pública será https://TS_HOSTNAME.<tu-tailnet>.ts.net
TS_HOSTNAME=plataforma
